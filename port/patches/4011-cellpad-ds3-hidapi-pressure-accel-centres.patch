+/* A string from SDL or the environment for one log line: printable ASCII only, at most n-1 bytes, NULL -> "?". */
+static inline void pad_log_clean(char* dst, size_t n, const char* src)
+{
+    size_t i = 0;
+    if (!n) return;
+    if (!src) src = "?";
+    for (; src[i] && i + 1 < n; i++) dst[i] = (src[i] >= 0x20 && src[i] <= 0x7E) ? src[i] : '?';
+    dst[i] = 0;
+}
