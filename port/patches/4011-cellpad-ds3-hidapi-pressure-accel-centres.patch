+/* DualShock 3 centre. SDL's main PS3 driver (SDL_hidapi_ps3.c ScaleAccel :343-348, use :514-516 and :1371-1373,
+ * release-3.4.x): SDL x = (b41/42 - 511)/113 g, y = -(b45/46 - 511)/113 g, z = -(b43/44 - 511)/113 g, in the SDL standard frame
+ * (y up: a flat pad reads y = +g, so Y = 511 - 113 = 398). RPCS3's DS3 handler (ds3_pad_handler.cpp:430-437, master) reads the words as
+ * x = b41, z = b43, y = b45, gyro b47 (ds3_pad_handler.h:56-59) -> cellPad X/Y/Z/G, and flips raw X on a raw HID read (console
+ * X = 1024 - raw X, :433). With that flip the main driver's inverse is X = 513 - 113 x/g, Y = 511 - 113 y/g, Z = 511 - 113 z/g,
+ * which agrees with the sixaxis path (:350-353, :1028-1030: -(raw - 512)/113 g on every axis, = 512 - 113 a/g, a console-convention
+ * driver) to within 1 count; the DS4/DualSense mapping (RPCS3 ds4_pad_handler.cpp:890-902: -accel*113 + 512, SDL's PS4 accel is the
+ * same y-up frame) is 512 - 113 a/g too. So pad_sdl_sensors' 512 is right for DS4/DualSense and the sixaxis path; for a PS3-type
+ * pad this shifts the words onto the main driver's centres (a PS3-type pad cannot be told apart by driver here). ASSUMPTION: the X flip
+ * is RPCS3's reading of a raw HID report, not verified on a console; the 1-count centre is below the DS3's own offset spread.
+ * Call after pad_sdl_sensors; does nothing without accelerometer data (has_sensor with a DS3 means accel; it has no gyro). */
+static inline void pad_sdl_sensors_ds3_centre(PadHostState* hs)
+{
+    if (!hs->has_sensor) return;
+    hs->sensor_x = pad_sensor_word((float)hs->sensor_x + 1.0f);
+    hs->sensor_y = pad_sensor_word((float)hs->sensor_y - 1.0f);
+    hs->sensor_z = pad_sensor_word((float)hs->sensor_z - 1.0f);
+}
+
 /* DS3 actuators: motor[SMALL] is on/off (0 or 1, any non-zero counts), motor[LARGE] is 0-255. SDL's low-frequency
