+static const char* g_ld_sg_why = "?";
+static const rsx_dsp_surface* g_ld_sg_sf;   /* render-target / mrt: the surface state */
+static u32 g_ld_sg_blit[7];                 /* blit-dst: src loc, src abs, src pitch, src slot, dst pitch, w, h */
 static u32 surface_get(u32 location, u32 offset, u32 want_w, u32 want_h,
                        DXGI_FORMAT want_fmt)
