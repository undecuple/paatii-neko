+/* Up to 16 comma-separated hex hashes from an environment variable. */
+static u32 eng_parse_hash_list(const char* name, u64 out[16])
+{
+    const char* e = getenv(name);
+    u32 n = 0;
+    while (e && *e && n < 16) {
+        char* end;
+        const u64 v = strtoull(e, &end, 16);
+        if (end == e) break;
+        if (v) out[n++] = v;
+        if (*end != ',') break;
+        e = end + 1;
+    }
+    return n;
