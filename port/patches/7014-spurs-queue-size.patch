cellSpurs: cellSpursQueueSize reports the queue's occupancy.
Toro's own patch (7xxx), candidate for upstream.
What: cellSpursQueueSize(queue, size) writes the number of entries from the ring indices (W0 pop, W1 push, modulo
2*W3), the model cellSpursQueuePushBody already uses; NULL and alignment errors as the SDK's.
Why: the import had no handler, so it was unresolved and faked CELL_OK without writing *size. Toro Lets Party drains a
PPU->SPU queue each frame after the prologue (func_0019A280: QueueSize, usleep(10) while the size is above zero, up to
300000 times); the stale stack value kept it looping to the cap, so every frame took about 3.2 s (run tlp-story5,
watchdog: main thread at lr 0x0019A2E0, unresolved NID 0x54876603). RPCS3 runs the firmware's libsre for this.
diff --git a/libs/spurs/cellSpurs.c b/libs/spurs/cellSpurs.c
--- a/libs/spurs/cellSpurs.c	2026-10-20 14:54:25.663825279 -0500
+++ b/libs/spurs/cellSpurs.c	2026-10-20 14:54:25.680272993 -0500
@@ -4060,6 +4060,37 @@
     return CELL_OK;
 }
 
+/* SDK ABI: cellSpursQueueSize(CellSpursQueue*, unsigned int* size): the number of entries in the queue.
+ *
+ * Toro Lets Party drains a PPU->SPU queue before it goes on (func_0019A280: QueueSize, then usleep(10) while the size
+ * is above zero, at most 300000 times). With no handler the import was unresolved: it returned CELL_OK without writing
+ * *size, so the loop read stale stack, waited out all 300000 rounds and every frame took about 3.2 s. The occupancy is
+ * the ring's: W0 (+0x00) the pop index, W1 (+0x04) the push index, both normalised and running modulo 2*W3 (+0x0C),
+ * the same model cellSpursQueuePushBody uses (derived from the SPU consumer at 0x12914..0x129D0). */
+s32 cellSpursQueueSize(u64 queue_ea, u64 size_ea)
+{
+    if (!queue_ea || !size_ea) return CELL_SPURS_TASK_ERROR_NULL_POINTER;
+    if (queue_ea & 0x7F)       return CELL_SPURS_TASK_ERROR_ALIGN;
+
+    uint32_t q   = (uint32_t)queue_ea;
+    int32_t  w0  = (int32_t)vm_read32(q + 0x00);
+    int32_t  w1  = (int32_t)vm_read32(q + 0x04);
+    int32_t  mod = (int32_t)vm_read32(q + 0x0C);
+    if (mod <= 0) mod = (int32_t)vm_read32(q + 0x14);       /* depth */
+    if (mod <= 0) return CELL_SPURS_TASK_ERROR_INVAL;
+
+    int32_t  pop  = (w0 < 0) ? ~w0 : w0;
+    int32_t  push = (w1 < 0) ? ~w1 : w1;
+    uint32_t n    = (uint32_t)((pop > push) ? push - pop + 2 * mod : push - pop);
+    vm_write32((uint32_t)size_ea, n);
+
+    static int _n = 0;
+    if (_n < 8 || (n && _n < 64))
+        printf("[cellSpurs] QueueSize(q=0x%08X) -> %u (pop=%d push=%d mod=%d)\n", q, n, pop, push, mod);
+    _n++;
+    return CELL_OK;
+}
+
 /* SDK ABI: cellSpursQueuePushBody(CellSpursQueue*, const void* buffer, bool isBlocking) */
 s32 cellSpursQueuePushBody(u64 queue_ea, u64 data_ea, u32 isBlocking)
 {
