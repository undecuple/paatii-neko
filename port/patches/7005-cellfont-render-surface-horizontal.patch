+               font, code, (double)x, (double)y, (uint32_t)ctx->lr, (unsigned)rc,
+               vm_read32(surf + SURF_O_BUFFER), vm_read32(surf + SURF_O_WIDTHBYTE), vm_read32(surf + SURF_O_PIXELSIZE),
+               vm_read32(surf + SURF_O_WIDTH), vm_read32(surf + SURF_O_HEIGHT), vm_read32(surf + SURF_O_SC_X0),
+               vm_read32(surf + SURF_O_SC_Y0), vm_read32(surf + SURF_O_SC_X1), vm_read32(surf + SURF_O_SC_Y1),
+               ti ? vm_read32(ti + TI_O_IMAGE) : 0, ti ? vm_read32(ti + TI_O_IMAGEWB) : 0,
+               ti ? vm_read32(ti + TI_O_IMAGEW) : 0, ti ? vm_read32(ti + TI_O_IMAGEH) : 0,
+               ti ? vm_read32(ti + TI_O_SURFACE) : 0, ti ? vm_read32(ti + TI_O_SURFWB) : 0);
+}
+
+extern void ps3_hle_register_ctx(uint32_t nid, const char* name, void (*fn)(ppu_context*));
