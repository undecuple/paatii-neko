+/* Toro patch 7001: a job chain posts NOTHING to the queues attached with
+ * cellSpursAttachLv2EventQueue. That call connects the queue to the SPURS SPU
+ * thread group (sys_spu_thread_group_connect_event_all_threads), so the only
+ * events on it are the ones SPU code sends itself with sys_spu_thread_send_event
+ * (WrOutMbox = data, WrOutIntrMbox = port<<24 | 24-bit value), which the lv2
+ * user-event path already routes for job contexts through spurs_port_queue().
+ * Toro's sound jobs do exactly that: the PPU stores the attached port into the
+ * job descriptor (@0x1F28F8 lbz obj+0x21C -> desc+0x30) and each job sends
+ * (port 16, slot index, query answer); the PPU reads data2 low word as the slot
+ * index and data3 as the answer (@0x1F294C..0x1F2A18). The synthetic per-job
+ * event below arrived as well, with data2 = a lap counter, filled the queue
+ * (the job's own send then got EBUSY) and sent the PPU past its slot table.
+ * Kept only as an opt-in fallback for titles whose job images are not lifted
+ * yet: SPURS_JC_SYNTH_EVENTS=1. */
+static int jc_synth_events(void)
+{
+    static int v = -1;
+    if (v < 0) {
+        const char* e = getenv("SPURS_JC_SYNTH_EVENTS");
+        v = (e && *e && *e != '0') ? 1 : 0;
+        printf("[cellSpurs] job chain completion events: %s\n",
+               v ? "synthetic (SPURS_JC_SYNTH_EVENTS)" : "none (jobs send their own)");
+    }
+    return v;
+}
