diff --git a/tests/test_rsx_vp_brb.c b/tests/test_rsx_vp_brb.c
new file mode 100644
--- /dev/null
+++ b/tests/test_rsx_vp_brb.c
@@ -0,0 +1,66 @@
+/* Host test: boolean-register branches in a vertex program (BRB 0x11, CLB 0x12) follow the transform branch bits
+ * the caller sets (rsx_vp_set_branch_bits): bit D3[23:27] is compared with D3[28] and the outcome is baked into the
+ * HLSL. Before the fix the decompiler emitted "not modelled" and always fell through. rsx_vp_uses_branch_bits() tells
+ * the caller to key the program on the bits.
+ *
+ *   gcc -O1 -w -I<ps3recomp>/include -Ilibs/video tests/test_rsx_vp_brb.c libs/video/rsx_vp_decompiler.c -o t && ./t
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "ps3emu/ps3types.h"
+#include "rsx_vp_decompiler.h"
+
+static void put(u8* p, u32 d0, u32 d1, u32 d2, u32 d3)
+{
+    u32 w[4] = { d0, d1, d2, d3 };
+    memcpy(p, w, 16);   /* the decompiler reads little-endian words */
+}
+
+/* [0] BRB/CLB idx, cond_true -> slot 2; [1] nothing; [2] nothing, END */
+static void prog(u8* uc, u32 op, u32 idx, u32 cond_true)
+{
+    memset(uc, 0, 48);
+    put(uc + 0, 0, op << 27, 0, (idx << 23) | (cond_true << 28) | (2u << 29));
+    put(uc + 32, 0, 0, 0, 1);
+}
+
+static int check(u32 op, u32 idx, u32 cond_true, u32 bits, int taken)
+{
+    u8 uc[48];
+    prog(uc, op, idx, cond_true);
+    static char out[1 << 18];
+    rsx_vp_set_branch_base(0);
+    rsx_vp_set_branch_bits(bits);
+    if (rsx_vp_decompile_ex(uc, sizeof uc, 0, out, sizeof out) < 0) { printf("FAIL decompile idx=%u\n", idx); return 1; }
+    const char* want = !taken ? "        _pc = 1;\n"
+                     : op == 0x11 ? "        _pc = 2;\n"
+                     : "        _cs[_csp] = 1; _csp = min(_csp + 1, 7); _pc = 2;\n";
+    if (!strstr(out, want)) {
+        printf("FAIL op=0x%X idx=%u cond_true=%u bits=0x%X: missing [%.*s]\n", op, idx, cond_true, bits,
+               (int)strlen(want) - 1, want);
+        return 1;
+    }
+    if (strstr(out, "not modelled")) { printf("FAIL: still 'not modelled'\n"); return 1; }
+    return 0;
+}
+
+int main(void)
+{
+    int bad = 0;
+    bad |= check(0x11, 0, 1, 0x1u, 1);          /* taken when bit 0 is set   */
+    bad |= check(0x11, 0, 1, 0x0u, 0);
+    bad |= check(0x11, 0, 0, 0x0u, 1);          /* taken when bit 0 is clear */
+    bad |= check(0x11, 0, 0, 0x1u, 0);
+    bad |= check(0x11, 7, 1, 0x80u, 1);
+    bad |= check(0x11, 31, 0, 0x7FFFFFFFu, 1);
+    bad |= check(0x12, 4, 1, 0x10u, 1);         /* CLB pushes the return slot like CAL */
+    bad |= check(0x12, 4, 1, 0x0u, 0);
+    u8 uc[48];
+    prog(uc, 0x11, 0, 1);
+    if (!rsx_vp_uses_branch_bits(uc, sizeof uc)) { puts("FAIL: BRB program not reported"); bad = 1; }
+    prog(uc, 0x09, 0, 1);                       /* BRI: no branch bits */
+    if (rsx_vp_uses_branch_bits(uc, sizeof uc)) { puts("FAIL: BRI program reported"); bad = 1; }
+    puts(bad ? "test_rsx_vp_brb: FAIL" : "test_rsx_vp_brb: ok");
+    return bad;
+}
